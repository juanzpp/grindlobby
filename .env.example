NEXT_PUBLIC_SUPABASE_URL=https://eilaxaklqgyvgjgpkonv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_t_uiyr5fFapSPvusy5DtBA_M86m5bzO
# SERVER ONLY. Obtain from Supabase dashboard. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# LiveKit SFU. API key/secret are server-only; never prefix the secret with NEXT_PUBLIC_.
NEXT_PUBLIC_LIVEKIT_URL=wss://voice.example.com
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Server-only comma-separated auth user IDs that receive admin/PRO test capabilities.
GRINDLOBBY_ADMIN_USER_IDS=

# Server-only HMAC salt used to pseudonymize rate-limit and security-log keys.
RATE_LIMIT_SALT=replace_with_a_long_random_value

# Server-side feature gate. Keep confirmation/recovery infrastructure available while false.
REQUIRE_EMAIL_CONFIRMATION=false

# Allowed decoupled frontend origins for /api/v1. Comma-separated origins only,
# without paths. The current Lovable published/preview origins are already in the
# code allowlist; add the future GrindLobby custom domain here.
FRONTEND_ORIGINS=https://app.grindlobby.example

# Music search. Keep server-only credentials out of NEXT_PUBLIC_ variables.
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
