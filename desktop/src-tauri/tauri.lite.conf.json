{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GrindLobby Performance",
  "version": "0.2.0",
  "identifier": "com.grindlobby.performance",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
