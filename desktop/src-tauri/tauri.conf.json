{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GrindLobby",
  "version": "0.1.1",
  "identifier": "com.grindlobby.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src https://grindlobby.onrender.com"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "GrindLobby Software",
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
